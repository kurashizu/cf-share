/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * NOTE: `main` here is the adapter-cloudflare BUILD TARGET (where SvelteKit's
 * `vite build` writes the generated fetch-only worker). To deploy the worker
 * WITH the cron `scheduled` handler, run:
 *
 *   vite build && wrangler deploy custom-worker.ts
 *
 * The positional entry (`custom-worker.ts`) overrides `main`, imports the
 * generated worker, and adds the `scheduled` handler (see custom-worker.ts).
 * `assets.directory`/`binding` are read from this config at deploy time.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-share",
  // Adapter build target (SvelteKit `/api/download/:token` GET streams the
  // file natively at the Worker layer — no OpenNext node-server bridge).
  "main": "./build/worker.js",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./build/assets",
  },
  // D1 — stores shares / upload_quota / audit_log
  // Create via: npx wrangler d1 create cf-share-db
  // Then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-share-db",
      "database_id": "9ae0b2e1-8840-49d9-a7ba-694462f5ea5f",
    },
  ],
  // Rate limits — cf-share specific.
  // Wrangler only allows `period` = 10s or 60s for built-in rate limits.
  "ratelimits": [
    {
      "name": "UPLOAD_INIT_LIMIT",
      "namespace_id": "3001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "UPLOAD_COMPLETE_LIMIT",
      "namespace_id": "3002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "DOWNLOAD_LIMIT",
      "namespace_id": "3003",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "DOWNLOAD_LOOKUP_LIMIT",
      "namespace_id": "3005",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "GLOBAL_IP_DAILY",
      "namespace_id": "3004",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  // Triggers — cleanup cron. The `scheduled` handler lives in `custom-worker.ts`
  // (see that file's doc comment). Runs every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Vars (non-sensitive).
  // NOTE: S3_ENDPOINT must match `lib/config/app.ts` → S3_PUBLIC_ENDPOINT.
  "vars": {
    "S3_ENDPOINT": "https://s3api.022025.xyz",
    "S3_REGION": "auto",
    "S3_BUCKET": "cf-share",
    "MAX_FILE_SIZE": "5368709120",
    "MAX_FILE_SIZE_ADMIN": "107374182400",
    "MIN_SHARE_TTL": "300",
    "MAX_SHARE_TTL": "604800",
    "MAX_DAILY_BYTES_PER_IP": "21474836480",
    "MAX_DAILY_COUNT_PER_IP": "100",
    "MAX_TOTAL_BYTES": "107374182400",
    "UPLOAD_URL_TTL": "3600",
    "ADMIN_JWT_TTL_SECONDS": "28800",
    // Cleanup cron tunables (consumed by lib/s3/cleanup.ts)
    "CLEANUP_BATCH_SIZE": "500",
    "CLEANUP_MAX_BATCH_MS": "25000",
    "CLEANUP_QUOTA_KEEP_DAYS": "30",
    "CLEANUP_AUDIT_KEEP_DAYS": "30",
  },
  // Secrets (use .dev.vars locally, `wrangler secret put` in production):
  //   S3_ACCESS_KEY_ID
  //   S3_SECRET_ACCESS_KEY
  //   CRON_SECRET            — required for /api/cron/cleanup HTTP trigger
  //   ADMIN_PASSWORD         — password for the /admin panel login form
  //   ADMIN_JWT_SECRET       — HMAC secret for signing the admin session JWT
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}