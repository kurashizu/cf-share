{
  "name": "cf-share",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "vite build && wrangler deploy custom-worker.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "s3:ping": "node scripts/s3-ping.mjs",
    "db:migrate:local": "wrangler d1 execute DB --local  --file=database/schema.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=database/schema.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@xmldom/xmldom": "^0.9.10",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "vite": "^8.2.1",
    "wrangler": "^4.86.0"
  }
}
